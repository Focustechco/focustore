# Local development only; the SQLite schema is not suitable for Vercel/serverless.
DATABASE_URL="file:./dev.db"
# Generate a random secret with at least 32 bytes before production use.
NEXTAUTH_SECRET=""
# Use at least 32 random bytes for signed guest-order access. Never commit a real value.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PAYMENT_GATEWAY_PROVIDER="mock_gateway"
# Mock checkout and webhook are unavailable in production.
# Demo seeds require explicit opt-in and a *_demo.db or *_test.db SQLite URL.
FOCUS_ALLOW_DEMO_SEED=false

# Social login: server-only variables. Set the exact canonical site origin.
SOCIAL_LOGIN_ORIGIN="http://localhost:3000"
# At least 32 random bytes. May use NEXTAUTH_SECRET if this is left empty.
SOCIAL_LOGIN_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple web requires an HTTPS domain, never localhost or an IP address.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# Contents of the .p8 private key. Literal \n line breaks are accepted.
APPLE_PRIVATE_KEY=""
