APP_NAME=FocusStore API
APP_VERSION=0.1.0
FOCUS_DEBUG=false
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/focustore_db
# PostgreSQL is the catalog source for the local MVP integration.
CATALOG_SOURCE=postgresql
# Optional: absolute path to the SAME SQLite used by Prisma; read-only catalog.
# LEGACY_CATALOG_SQLITE_PATH=/absolute/path/to/focustore/prisma/dev.db

# Optional canonical browser origin for credentialed CORS and admin writes.
# FRONTEND_ORIGIN=http://localhost:3000
# Customer authentication defaults to secure, HttpOnly, SameSite=Lax cookies.
# AUTH_COOKIE_SECURE=true
# AUTH_SESSION_TTL_MINUTES=10080
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_IP_ATTEMPTS=30
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# LEGACY_CATALOG_SQLITE_PATH also supplies read-only identities and own orders.
# Use the exact same Prisma SQLite file as Next.js, never a copied session DB.
