APP_NAME=FocusStore API
APP_VERSION=0.1.0
FOCUS_DEBUG=false
APP_ENVIRONMENT=production
ALLOW_LOCAL_WRITES=false
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/focustore_db
# Optional: absolute path to the SAME SQLite used by Prisma; read-only catalog.
# LEGACY_CATALOG_SQLITE_PATH=C:/path/to/focustore/prisma/dev.db
# Optional JSON list, passed automatically by npm run dev:fullstack:
# LEGACY_CATALOG_EXCLUDED_SLUGS=["camisa-dev-collection-csharp"]
